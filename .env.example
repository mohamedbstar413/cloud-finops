# SQLite for local dev. For production use PostgreSQL: see "Running in production" in the README.
DATABASE_URL="file:./dev.db"

# OpenAI powers the Architecture Advisor (enrichment, AI discovery, what-if planning,
# custom architecture analysis). Without a key the app falls back to the deterministic engine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# 32-byte key (hex or base64) used to encrypt cloud credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional ticketing integration. If unset, tickets are stored internally.
TICKET_WEBHOOK_URL=""

# Public URL of the app, used in emails (invitations, password resets, notifications).
APP_URL="http://localhost:3100"

# Transactional email through Resend. Without it, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Cloud Price Optimizer <no-reply@example.com>"

# Background worker. Development runs it inside `npm run dev`; in production run
# `npm run worker` separately and set WORKER_MODE=separate on the web servers.
WORKER_MODE=""
WORKER_CONCURRENCY="2"

# Payments (Stripe). Without them the Billing page shows plans but cannot charge.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""

# Password for the seeded demo users (mohamed@acme.com, …). Leave empty in production.
SEED_PASSWORD=""
