# SQLite for local dev. Switch provider in prisma/schema.prisma to "postgresql" for production.
DATABASE_URL="file:./dev.db"

# OpenAI powers the Architecture Advisor (enrichment, AI discovery, what-if planning,
# custom architecture analysis). Without a key the app falls back to the deterministic engine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# 32-byte key (hex or base64) used to encrypt cloud credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional ticketing integration. If unset, tickets are stored internally.
TICKET_WEBHOOK_URL=""
